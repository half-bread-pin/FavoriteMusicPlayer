<!-- FavoriteMusicPlayer 公共构建配置：由 FavoriteMusicPlayer.csproj(4.0.13) 和
     FavoriteMusicPlayer.4_1.csproj(4.1.6) 导入，差异项（GameDir/DistLine/SPT41）在各 csproj 中先定义 -->
<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FavoriteMusicPlayer</RootNamespace>
    <AssemblyName>FavoriteMusicPlayer</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 双 csproj 共存于同一目录：从源码通配中排除全部 obj/bin
         （默认排除只盖当前项目自己的 BaseIntermediateOutputPath，会漏掉兄弟项目的） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 游戏安装目录（构建时只读引用其中的 DLL，绝不写入），由各版本 csproj 指定默认值，
         可用 dotnet build -p:GameDir="..." 覆盖 -->
    <ManagedDir>$(GameDir)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <SptPluginsDir>$(GameDir)\BepInEx\plugins\spt</SptPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 核心 -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SPT 客户端模块（ModulePatch 所在） -->
    <Reference Include="spt-reflection">
      <HintPath>$(SptPluginsDir)\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏程序集 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Release 构建后把 DLL 复制到 dist/<版本线>/FavoriteMusicPlayer/（打包目录，不直接写游戏目录） -->
  <Target Name="CopyToDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\dist\$(DistLine)\FavoriteMusicPlayer\" />
    <Message Importance="high" Text="已复制 $(TargetFileName) 到 dist\$(DistLine)\FavoriteMusicPlayer\" />
  </Target>
</Project>
